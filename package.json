{
  "name": "ai-buddy-first-check",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --env-file-if-exists=.env --watch server/main.ts\" \"vite\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "eval:buddy": "node --env-file-if-exists=.env scripts/eval-buddy.ts",
    "eval:hardening": "node --env-file-if-exists=.env scripts/eval-hardening.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "express": "5.3.0",
    "lucide-react": "1.71.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "4.1.12",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "31.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "4.1.12"
  }
}
