# API и приложение после сборки доступны на http://127.0.0.1:3001.
# Для pnpm dev оставьте порт 3001, чтобы Vite нашёл API.
PORT=3001

# Оставьте поля пустыми для режима «Демо-справка».
# Для модели укажите URL OpenAI-совместимого API до /chat/completions.
BUDDY_BASE_URL=
BUDDY_MODEL=
BUDDY_API_KEY=
