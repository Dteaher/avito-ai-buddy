# API и приложение после сборки доступны на http://127.0.0.1:3001.
# Для pnpm dev оставьте порт 3001, чтобы Vite нашёл API.
PORT=3001

# Пустые поля включают демо-справку. Для локальной Ollama используйте
# BUDDY_BASE_URL=http://127.0.0.1:11434/v1 и BUDDY_MODEL=qwen3:4b-instruct-2507-q4_K_M.
# Для удалённого провайдера укажите HTTPS-адрес до /chat/completions и ключ.
BUDDY_BASE_URL=
BUDDY_MODEL=
BUDDY_API_KEY=
# Для первого запуска локальной модели можно увеличить тайм-аут до 45000.
BUDDY_TIMEOUT_MS=12000
